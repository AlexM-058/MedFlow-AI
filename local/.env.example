LOCAL_AGENT_TOKEN=
LOCAL_AGENT_MODEL=gemma3:1b

# Extraction service (start-stack.ps1 reads these; defaults are the laptop setup: no GPU, text-only model).
# GPU PC (RTX 2060, 6 GB): EDGE_LLM_MEDGEMMA=medgemma1.5:4b, OCR_ENGINE=easyocr (or tesseract), OCR_FALLBACK=on
# (MedGemma 4B sees images, so it can read a bad photo when OCR is unsure). Without a GPU keep OCR_FALLBACK=off.
EDGE_LLM_MEDGEMMA=gemma3:1b
OCR_ENGINE=tesseract
OCR_FALLBACK=off
EASYOCR_GPU=true
