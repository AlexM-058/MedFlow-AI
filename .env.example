# MedFlow Environment Variables
# Copy this file to .env and fill in the required keys.

# Google Gemini API Key for Doctor AI orchestration
GEMINI_API_KEY=your_gemini_api_key_here

# Address of the AI cloud HTTP service (cloud/server.ts, started with `npm run dev`).
# MedFlow-Backend calls it at AI_URL=http://127.0.0.1:8091. In an Azure container: HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8091

# Local LLM endpoint (e.g., Ollama)
# Default is http://localhost:11434
EDGE_LLM_ENDPOINT=http://localhost:11434
EDGE_LLM_MODEL=llama3
